# Copy to .env and fill in. Coolify: set these in the service's Environment tab instead.

# Gate password. If left blank, the server falls back to "hiharley".
SITE_PASSWORD=

# Discord Incoming Webhook URL (Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL).
# Keep this secret. If blank, answers are still recorded, the webhook post is just skipped.
DISCORD_WEBHOOK_URL=

# Your friend's Discord user ID, so the ping actually notifies him on mobile.
# Discord -> Settings -> Advanced -> Developer Mode ON, then right-click his name -> Copy User ID.
# Blank = no ping, just the embed.
DISCORD_MENTION_ID=

# Secret used to sign the "unlocked" cookie. Any long random string.
# If blank, a random one is generated per boot (everyone gets logged out on restart).
COOKIE_SECRET=

# --- usually leave these alone ---
# Where the web container reaches the Go service. Compose sets this automatically.
# SERVER_ORIGIN=http://server:8080
# Directory the Go service writes answer.json into.
# DATA_DIR=/data
# Marks the deploy as production (enables the Secure flag on the cookie).
# PROD=true
